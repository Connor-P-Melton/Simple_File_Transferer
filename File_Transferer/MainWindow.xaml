<Window x:Class="File_Transferer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:File_Transferer"
        mc:Ignorable="d"
        Title="Local File Transferer" Height="500" Width="500">
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Top: IP address and port -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,5,10">
            <Label Content="IP Address" />
            <TextBox x:Name="IpTextBox" Text="127.0.0.1" Padding="4" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,10">
            <Label Content="Port" />
            <TextBox x:Name="PortTextBox" Text="5000" Padding="4" />
        </StackPanel>

        <!-- Middle: drag and drop box -->
        <Border x:Name="DropZone"
                Grid.Row="1" Grid.ColumnSpan="2"
                Margin="0,0,0,10"
                BorderBrush="Gray" BorderThickness="2"
                CornerRadius="6" Background="#F5F5F5"
                AllowDrop="True"
                Drop="DropZone_Drop">
            <TextBlock Text="Drag and drop"
                       FontSize="18" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Bottom: sent and received -->
        <GroupBox Grid.Row="2" Grid.Column="0" Header="Sent" Margin="0,0,5,0">
            <ListBox x:Name="SentListBox" />
        </GroupBox>

        <GroupBox Grid.Row="2" Grid.Column="1" Header="Received" Margin="5,0,0,0">
            <ListBox x:Name="ReceivedListBox" />
        </GroupBox>

    </Grid>
</Window>